{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: configure merge pulls",
      "type": "shell",
      "command": "git config pull.rebase false",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "PolyTrack: run tests",
      "type": "shell",
      "command": "python -m pytest polytrack-ai-generator/tests -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "PolyTrack: generate one code",
      "type": "shell",
      "command": "python CodeMaker",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "PolyTrack: generate sample codes",
      "type": "shell",
      "command": "cd polytrack-ai-generator && python -m core.generator",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
